# Dev-only variables (Proton Pass secrets)
#
# Loaded only when APP_MODE=dev (see the @import in .env.schema), so the proton-pass plugin and its protonPass()
# calls stay out of the production image. The vault paths are placeholders: replace them with the real items.
# @plugin(@varlock/proton-pass-plugin@0.0.3)
# @initProtonPass()
# @defaultRequired=true @defaultSensitive=true
# ---

RA_TOKEN=protonPass("pass://DCC-KI/BEBBI_DEEP_RESEARCH/RA_TOKEN")
HMAC_SECRET=protonPass("pass://DCC-KI/BEBBI_DEEP_RESEARCH/HMAC_SECRET")

# @optional
RA_LLM_API_KEY=protonPass("pass://DCC-KI/BEBBI_DEEP_RESEARCH/LLM_API_KEY", allowMissing=true)
# @optional
RA_SEARCH_KEY=protonPass("pass://DCC-KI/BEBBI_DEEP_RESEARCH/SERPER_API_KEY", allowMissing=true)
# @optional
RA_FIRECRAWL_KEY=protonPass("pass://DCC-KI/BEBBI_DEEP_RESEARCH/FIRECRAWL_API_KEY", allowMissing=true)
# @optional
OWUI_API_KEY=protonPass("pass://DCC-KI/BEBBI_DEEP_RESEARCH/OWUI_API_KEY", allowMissing=true)
# @optional
OWUI_DELIVERY_SECRET=protonPass("pass://DCC-KI/BEBBI_DEEP_RESEARCH/OWUI_DELIVERY_SECRET", allowMissing=true)
POSTGRES_PASSWORD=protonPass("pass://DCC-KI/BEBBI_DEEP_RESEARCH/POSTGRES_PASSWORD")
WEBUI_SECRET_KEY=protonPass("pass://DCC-KI/BEBBI_DEEP_RESEARCH/WEBUI_SECRET_KEY")
