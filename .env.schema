# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# Single source of truth for the configuration of the job service (reference: docs/operations.md).
# @defaultRequired=true @defaultSensitive=false
# @import(./.env.dev.schema, enabled=eq($APP_MODE, "dev"))
# ----------

# The app mode controls the varlock validation:
# dev and ci validate everything, build only build-time variables, prod only runtime variables.
# @type=enum(dev, ci, build, prod)
APP_MODE=dev

# @type=enum(DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=ifs(
    eq($APP_MODE, dev), DEBUG,
    eq($APP_MODE, ci), DEBUG,
    INFO
)

# Production: JSON log lines (backend-common logger)
# @type=boolean
IS_PROD=eq($APP_MODE, "prod")

# pydantic-ai prints a banner on the first agent run otherwise
# @type=boolean
PYDANTIC_AI_NO_BANNER=true

# The port of the FastAPI service
# @type=port
PORT=8088

## Secrets

# Bearer token of the API, same value as the SERVICE_TOKEN valve of the pipe. Full trust: its holder can read all jobs.
# CI uses a fixed placeholder, which is not a secret.
# @sensitive=not(eq($APP_MODE, ci))
RA_TOKEN=if(eq($APP_MODE, ci), ci-token, )

# Pseudonymises user ids in usage events. Create with: openssl rand 32 | base64
# @sensitive=not(eq($APP_MODE, ci))
HMAC_SECRET=if(eq($APP_MODE, ci), ci-hmac, )

# postgresql://user:password@host:5432/db (URL-encode special characters in the password); empty = SQLite in /tmp
# @optional @sensitive
RA_DATABASE_URL=

# API key of the LLM endpoint; empty for endpoints without auth. "{job}" is replaced by the job id (gateway metering).
# @optional @sensitive
RA_LLM_API_KEY=

# API key of the embeddings endpoint, used only with RA_LLM_EMBED_BASE_URL ("{job}" as above)
# @optional @sensitive
RA_LLM_EMBED_API_KEY=

# Serper API key ("{job}" is replaced by the job id)
# @optional @sensitive
RA_SEARCH_KEY=

# @optional @sensitive
RA_FIRECRAWL_KEY=

# API key of the Open WebUI admin service account (knowledge base retrieval, file dates); not used for delivery
# @optional @sensitive
OWUI_API_KEY=

# Shared secret of the report delivery endpoint in the Open WebUI image (same value as DCC_DEEP_RESEARCH_DELIVERY_SECRET
# there); empty = no delivery (jobs end with `delivery: skipped`, the pipe returns the report on the next message)
# @optional @sensitive
OWUI_DELIVERY_SECRET=

## LLM

# OpenAI-compatible endpoint (vLLM)
# @type=url
RA_LLM_BASE_URL=ifs(eq($APP_MODE, ci), "http://llm/v1", eq($APP_MODE, dev), "http://localhost:4000/v1", )
# Embeddings endpoint when the gateway serves them under another path; empty: RA_LLM_BASE_URL
# @optional @type=url
RA_LLM_EMBED_BASE_URL=
RA_LLM_MODEL_THINK=gemma-think
RA_LLM_MODEL_FAST=gemma-fast
RA_LLM_MODEL_EMBED=qwen-embed
# Extra request body per role as JSON, e.g. {"chat_template_kwargs": {"enable_thinking": true}}
# @optional
RA_LLM_EXTRA_BODY_THINK=
# @optional
RA_LLM_EXTRA_BODY_FAST=

## Search and fetch

# @type=url
RA_SEARCH_URL=ifs(eq($APP_MODE, ci), "http://search/search", eq($APP_MODE, dev), "http://localhost:4000/serper/search", )
# @type=url
RA_FIRECRAWL_URL=ifs(eq($APP_MODE, ci), "http://firecrawl", eq($APP_MODE, dev), "http://localhost:3002", )

## Open WebUI

# Base URL of Open WebUI for the delivery of reports and knowledge base retrieval
# @optional @type=url
OWUI_URL=

# Full URL of the delivery endpoint; empty = OWUI_URL + /api/v1/dcc/deep-research/deliver
# @optional @type=url
OWUI_DELIVERY_URL=

## Job queue

# Presets file; default: config/presets.yaml of the image
# @optional
RA_PRESETS=
RA_NIGHT_WINDOW=20:00-05:00
RA_TIMEZONE=Europe/Zurich
# @type=number(isInt=true)
RA_WORKERS=1
# @type=number(isInt=true)
RA_DAY_WORKERS=1
# Jobs per user and 24 h, 0 = off
# @type=number(isInt=true)
RA_QUOTA_PER_DAY=0
# @type=number
RA_POLL_SECONDS=5
# @type=number
RA_STALE_SECONDS=120

## Own sources (uploaded files and knowledge bases)

# @type=number(isInt=true)
RA_OWN_MAX_FILES=10
# @type=number(isInt=true)
RA_OWN_MAX_FILE_CHARS=2000000
# @type=number(isInt=true)
RA_OWN_MAX_COLLECTIONS=5

## Local docker compose stack only

# Goes into a URL: letters and digits only, or URL-encode
# @optional @sensitive
POSTGRES_PASSWORD=
# @optional @sensitive
WEBUI_SECRET_KEY=
