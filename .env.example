# Copy to .env (git-ignored) for `docker compose up`. Placeholders only.

# --- job service <-> pipe -----------------------------------------------------
RA_TOKEN=change-me-shared-with-the-pipe-valve

# --- LLM (OpenAI-compatible, vLLM in production) -------------------------------
# From inside the containers the host is host.docker.internal.
RA_LLM_BASE_URL=http://host.docker.internal:4000/v1
RA_LLM_API_KEY=
RA_LLM_MODEL_THINK=gemma-think
RA_LLM_MODEL_FAST=gemma-fast
RA_LLM_MODEL_EMBED=qwen-embed
# Thinking switch per role for production vLLM (same model, chat template kwargs). Empty = off.
# RA_LLM_EXTRA_BODY_THINK={"chat_template_kwargs":{"enable_thinking":true}}
# RA_LLM_EXTRA_BODY_FAST={"chat_template_kwargs":{"enable_thinking":false}}

# --- search and fetch ----------------------------------------------------------
RA_SEARCH_URL=http://host.docker.internal:4000/serper/search
RA_SEARCH_KEY=
RA_FIRECRAWL_URL=http://host.docker.internal:3002
RA_FIRECRAWL_KEY=

# --- Open WebUI delivery (admin service account API key; see docs/integration.md) --
OWUI_URL=http://open-webui:8080
OWUI_API_KEY=

# --- local compose stack ---------------------------------------------------------
POSTGRES_PASSWORD=change-me
WEBUI_SECRET_KEY=change-me
# RA_NIGHT_WINDOW=00:00-23:59    # run every job immediately while testing
# HTTP_PROXY= / HTTPS_PROXY= / NO_PROXY=

# --- scripts/e2e_owui.py (a normal test user of the local Open WebUI) ---------------
# TEST_USER_EMAIL=tester@example.test
# TEST_USER_PASSWORD=
